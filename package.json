{
  "name": "exploring-data.com",
  "version": "1.0.0",
  "scripts": {
    "build:modules": "esbuild src/modules/*.js --bundle --format=esm --minify --outdir=static/compiled",
    "watch:modules": "esbuild src/modules/*.js --bundle --format=esm --watch --outdir=static/compiled",
    "build:scripts": "babel src/js --out-dir static/compiled --no-comments",
    "via-ferrata:data": "cp ~/repos/priv/via-ferrata/data/all.topojson static/topojson/via-ferrata.topojson",
    "via-ferrata:script": "sed 's|./data/all.topojson|/topojson/via-ferrata.topojson|' ~/repos/priv/via-ferrata/app.js | babel --out-file static/compiled/map/via-ferrata.js --minified --no-comments",
    "via-ferrata:styles": "sass --no-source-map ~/repos/priv/via-ferrata/styles.css --style=compressed static/compiled/map/via-ferrata.css",
    "watch:scripts": "nodemon -e js -w src/js -x 'npm run build:scripts'",
    "build:styles": "sass --no-source-map src/css:static/css --style=compressed",
    "watch:styles": "nodemon -e css -w src/css -x 'npm run build:styles'",
    "copy:datatables": "copyfiles --flat node_modules/datatables.net/js/jquery.dataTables.min.js static/vendor/npm",
    "copy:subject-mapper": "copyfiles --flat node_modules/subject-mapper/dist/subject-mapper.css static/vendor/npm",
    "build": "run-p build:*",
    "watch": "run-p watch:*",
    "copy": "run-p copy:*",
    "serve": "logya serve",
    "start": "run-p serve watch",
    "update": "npm install -U --save && npm run copy",
    "via-ferrata": "run-p via-ferrata:*"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:exploringdata/website.git"
  },
  "author": "Ramiro Gómez",
  "license": "UNLICENSED",
  "devDependencies": {
    "babel-cli": "^6.26.0",
    "copyfiles": "^2.1.1",
    "esbuild": "^0.27.3",
    "nodemon": "^1.19.4",
    "npm-run-all": "^4.1.5",
    "sass": "^1.97.3"
  },
  "dependencies": {
    "@observablehq/plot": "^0.6.17",
    "d3": "^7.9.0",
    "d3-dsv": "^3.0.1",
    "datatables.net-bs": "^1.10.20",
    "subject-mapper": "^0.1.0",
    "topojson-client": "^3.1.0"
  }
}
